{
    "name": "@lumoauth/mcp",
    "version": "1.2.0",
    "description": "LumoAuth authentication and authorization for MCP servers built with the official TypeScript MCP SDK (v1 and v2): RFC 9728 discovery, Bearer and DPoP token verification, per-tool policy.",
    "license": "MIT",
    "author": "LumoAuth",
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "main": "dist/index.js",
    "module": "dist/index.mjs",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "README.md"
    ],
    "scripts": {
        "build": "tsup",
        "typecheck": "tsc --noEmit",
        "prepublishOnly": "npm run build",
        "test": "npm run build && node --test tests/*.test.mjs"
    },
    "keywords": [
        "lumoauth",
        "mcp",
        "model-context-protocol",
        "oauth",
        "dpop",
        "authorization"
    ],
    "dependencies": {
        "@lumoauth/agent": "^1.2.0",
        "@lumoauth/shared": "^1.2.0"
    },
    "devDependencies": {
        "@modelcontextprotocol/express": "^2.0.2",
        "@modelcontextprotocol/sdk": "^1.32.2",
        "@modelcontextprotocol/server": "^2.4.0",
        "@types/express": "^5.0.0",
        "@types/node": "^20.19.43",
        "express": "^5.2.1",
        "tsup": "^8.0.0",
        "typescript": "^5.5.0",
        "zod": "^4.1.0"
    },
    "engines": {
        "node": ">=20.0.0"
    },
    "sideEffects": false
}
