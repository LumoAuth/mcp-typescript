{
    "name": "@lumoauth/mcp-workspace",
    "version": "0.0.0",
    "private": true,
    "description": "Workspace root for LumoAuth's MCP server integrations for the official TypeScript MCP SDK and the `lumoauth secure` wrapper.",
    "license": "MIT",
    "workspaces": [
        "packages/mcp",
        "packages/lumoauth"
    ],
    "scripts": {
        "build": "npm run build --workspaces --if-present",
        "typecheck": "npm run typecheck --workspaces --if-present",
        "test": "npm run test --workspaces --if-present"
    },
    "overrides": {
        "@lumoauth/shared": "file:../sdk-js/packages/shared",
        "@lumoauth/agent": "file:../sdk-js/packages/agent"
    },
    "engines": {
        "node": ">=20.0.0"
    }
}
